// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Source {
  id                  String    @id @default(uuid())
  handle              String    @unique
  name                String
  lastScrapedAt       DateTime?
  scrapeIntervalHours Int       @default(24)
  customIntervalHours Int?
  isActive            Boolean   @default(true)
  events              Event[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Event {
  id              String   @id @default(uuid())
  sourceId        String
  source          Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  rawPostUrl      String
  rawCaption      String
  title           String
  startDate       String   // Format: YYYY-MM-DD
  endDate         String?  // Format: YYYY-MM-DD
  startTime       String?  // Format: HH:MM
  endTime         String?  // Format: HH:MM
  location        String?
  ageRange        String?
  ageGroup        String   @default("all") // infants | toddlers | preschoolers | kids | teens | all
  category        String   // sports | arts | nature | music | education | festival | other
  cost            String?
  isFree          Boolean  @default(false)
  registrationUrl String?
  status          String   @default("pending") // pending | approved | rejected
  confidence      Float    @default(1.0)
  latitude        Float?
  longitude       Float?
  likes           Int      @default(0)
  feedbacks       EventFeedback[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([rawPostUrl, title])
}

model EventFeedback {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type      String   // "like" | "report_inaccurate"
  reason    String?  // "wrong_date" | "wrong_location" | "cancelled" | "pricing_age" | "other"
  comment   String?
  createdAt DateTime @default(now())

  @@index([eventId])
}

