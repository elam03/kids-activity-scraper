{
  "name": "kids-activity-scraper",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:railway": "env $(cat .env.railway.local | grep -v '^#' | xargs) next dev",
    "build": "next build && mkdir -p .next/standalone/.next && cp -rf .next/static .next/standalone/.next/ && (cp -rf public .next/standalone/ || true)",
    "start": "next start",
    "lint": "next lint",
    "test": "tsx --test src/lib/*.test.ts",
    "postinstall": "prisma generate",
    "evaluate:today": "tsx scripts/evaluate-today-events.ts",
    "eval:today": "tsx scripts/evaluate-today-events.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.17.0",
    "google-auth-library": "^11.1.0",
    "jose": "^6.2.12",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.4.39",
    "prisma": "^5.17.0",
    "tailwindcss": "^3.4.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.5.3"
  }
}
