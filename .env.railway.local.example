# ============================================================
# Kids Activity Calendar — Railway Tunnel Local Dev
# ============================================================
# Copy this file to .env.railway.local and fill in values from
# Railway Dashboard → Postgres service → Variables tab.
#
# Usage:
#   1. Start tunnel in another terminal:
#      railway tunnel --service Postgres --port 5433
#   2. Run dev server against prod DB:
#      npm run dev:railway
#
# NEVER commit this file. It is gitignored.
# ============================================================

# --- Database (Railway tunnel — fills in by you from Railway Dashboard) ---
# Replace USER, PASSWORD, DBNAME with your actual Railway Postgres credentials
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5433/railway?sslmode=disable&connection_limit=3"

# --- Apify (same as .env.local) ---
APIFY_API_KEY=

# --- OpenAI (same as .env.local) ---
OPENAI_API_KEY=

# --- Admin Auth ---
ADMIN_PASSWORD=fr33SCRAPER

# --- App URL (production, for Railway cron references) ---
APP_URL=https://kids-activity-scraper-production.up.railway.app
