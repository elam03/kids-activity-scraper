# ============================================================
# Kids Activity Calendar — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# --- Apify ---
APIFY_API_KEY=

# --- OpenAI ---
OPENAI_API_KEY=

# --- Admin Auth ---
ADMIN_PASSWORD=

# --- Database (local dev) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kids_activity_dev"

# --- Database (Railway — set automatically via reference variable in prod) ---
# DATABASE_URL=${{Postgres.DATABASE_URL}}
