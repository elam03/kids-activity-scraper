# ============================================================
# Kids Activity Calendar — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# --- Apify ---
APIFY_API_KEY=your_apify_api_key_here

# --- OpenAI ---
OPENAI_API_KEY=your_openai_api_key_here

# --- Admin Auth ---
ADMIN_PASSWORD=fr33SCRAPER

# --- Database (local dev) ---
DATABASE_URL="file:./dev.db"

# --- Database (Railway — set automatically via reference variable in prod) ---
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# --- Cron Runner (Railway Cron Service env vars only — not needed by main web app) ---
# APP_URL: public URL of the deployed main web service (no trailing slash)
APP_URL=https://kids-activity-scraper-production.up.railway.app
# CRON_SECRET: must match ADMIN_PASSWORD on the main service (used to authenticate cron calls)
CRON_SECRET=fr33SCRAPER

# --- Analytics (Optional) ---
# Google Analytics 4 Measurement ID (defaults to G-P4ZPYFWRLK if omitted)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-P4ZPYFWRLK

# --- Google Authentication & One Tap ---
# Google OAuth 2.0 Web Client ID (from Google Cloud Console)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# Optional: 32-character string to sign JWT session cookies (falls back to ADMIN_PASSWORD if unset)
AUTH_SECRET=your_random_32_char_secret_key_here


